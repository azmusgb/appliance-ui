{
  "name": "appliance-ui",
  "version": "2.26.0",
  "private": true,
  "description": "The home appliance's shared look: tokens, components, the Needs-you renderer and the tool registry, copied into each app.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/",
    "screens": "node scripts/build.mjs && node scripts/screens.mjs",
    "contrast": "node scripts/contrast.mjs",
    "display": "node scripts/build.mjs && node scripts/display.mjs",
    "display:update": "node scripts/build.mjs && node scripts/display.mjs --update",
    "fonts": "python3 scripts/build-fonts.py",
    "drift": "node scripts/drift.mjs",
    "literals": "node check/literals.mjs src"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
